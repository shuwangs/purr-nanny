# Local development only. Replace both example secrets for your own setup.
# The MCP token must match in TOKEN_MAP and CHAT_MCP_TOKEN.
CAT_NANNY_TOKEN_MAP='{"local-demo-token-0123456789abcdef0123456789":{"household_id":"demo","timezone":"America/Chicago"}}'
CAT_NANNY_CHAT_MCP_TOKEN=local-demo-token-0123456789abcdef0123456789
CAT_NANNY_MCP_URL=http://127.0.0.1:8000/mcp/
CAT_NANNY_DB=cat_nanny.sqlite3
CAT_NANNY_CHAT_DB=cat_nanny_chat.sqlite3
CAT_NANNY_CHAT_PASSWORD=cat-nanny-local-chat-2026

# OpenAI: set mode to openai and keep your real key in .env only.
# CAT_NANNY_CHAT_MODE=openai
# OPENAI_API_KEY=your-private-api-key
# CAT_NANNY_OPENAI_MODEL=gpt-4.1-mini

# Configure an authorized AWS profile separately; do not put AWS keys here.
# Set to demo for fixed-phrase local chat without AWS; omit for Bedrock.
# CAT_NANNY_CHAT_MODE=demo
# AWS_PROFILE=your-profile
# AWS_DEFAULT_REGION=your-region
# CAT_NANNY_BEDROCK_MODEL_ID=your-tool-capable-model-or-inference-profile-id
